# Multi-architecture Dockerfile for reader-rust
# Expects pre-built binary at target-bin/${TARGETARCH}/reader-rust
# and frontend at frontend/dist

FROM alpine:3.19

ARG TARGETARCH

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

# Copy architecture-specific pre-built binary
COPY target-bin/${TARGETARCH}/reader-rust /app/reader-rust

# Copy frontend dist
COPY frontend/dist /app/web/dist

# Create storage directory and ensure binary is executable
RUN mkdir -p /app/storage/assets && chmod +x /app/reader-rust

# Environment defaults
ENV SERVER_HOST=0.0.0.0
ENV SERVER_PORT=8080
ENV DATABASE_URL=sqlite:/app/storage/reader.db?mode=rwc
ENV STORAGE_DIR=/app/storage
ENV ASSETS_DIR=/app/storage/assets
ENV WEB_ROOT=/app/web/dist
ENV LOG_LEVEL=info

EXPOSE 8080

VOLUME ["/app/storage"]

CMD ["./reader-rust"]
